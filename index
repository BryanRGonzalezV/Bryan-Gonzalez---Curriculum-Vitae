                                <span class="inline-block mt-1 text-xs bg-emerald-100 text-emerald-800 px-2.5 py-0.5 rounded font-medium">Graduado con honores</span>
                            </div>
                        </div>
                    </div>

                    <!-- FORMULARIO BÁSICO: Formulario de Contacto -->
                    <div id="contacto-form" class="no-print pt-6 border-t border-slate-200">
                        <div class="flex items-center mb-4">
                            <div class="bg-blue-600 text-white p-2 rounded-lg mr-2 text-sm">
                                <i class="fas fa-paper-plane"></i>
                            </div>
                            <h2 class="text-lg font-bold text-slate-800">Enviarme un Mensaje Directo</h2>
                        </div>
                        
                        <form id="contactForm" onsubmit="handleFormSubmit(event)" class="bg-slate-50 p-5 rounded-xl border border-slate-200 space-y-4">
                            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                                <div>
                                    <label for="nombre" class="block text-xs font-semibold text-slate-700 mb-1">Tu Nombre *</label>
                                    <input type="text" id="nombre" name="nombre" required placeholder="Ej. Juan Pérez" class="w-full px-3 py-2 text-sm border border-slate-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none">
                                </div>
                                <div>
                                    <label for="email" class="block text-xs font-semibold text-slate-700 mb-1">Tu Correo Electrónico *</label>
                                    <input type="email" id="email" name="email" required placeholder="ejemplo@correo.com" class="w-full px-3 py-2 text-sm border border-slate-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none">
                                </div>
                            </div>

                            <div>
                                <label for="asunto" class="block text-xs font-semibold text-slate-700 mb-1">Asunto *</label>
                                <input type="text" id="asunto" name="asunto" required placeholder="Oportunidad laboral / Consulta" class="w-full px-3 py-2 text-sm border border-slate-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none">
                            </div>

                            <div>
                                <label for="mensaje" class="block text-xs font-semibold text-slate-700 mb-1">Mensaje *</label>
                                <textarea id="mensaje" name="mensaje" rows="3" required placeholder="Escribe tu mensaje aquí..." class="w-full px-3 py-2 text-sm border border-slate-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none resize-none"></textarea>
                            </div>

                            <button type="submit" class="w-full sm:w-auto px-6 py-2.5 bg-blue-700 hover:bg-blue-800 text-white font-medium text-sm rounded-lg shadow-md transition duration-200 flex items-center justify-center space-x-2">
                                <i class="fas fa-paper-plane text-xs"></i>
                                <span>Enviar Mensaje</span>
                            </button>
                        </form>
                    </div>

                </div>

                <!-- Footer -->
                <div class="pt-6 border-t border-slate-200 text-xs text-slate-400 flex justify-between items-center mt-8">
                    <span>Bryan Gonzalez &copy; 2026</span>
                    <span>Curriculum Vitae Interactivo</span>
                </div>
            </section>

        </div>
    </main>

    <script>
        // Copiar texto al portapapeles
        function copyToClipboard(text, customMessage) {
            const tempInput = document.createElement('input');
            tempInput.value = text;
            document.body.appendChild(tempInput);
            tempInput.select();
            document.execCommand('copy');
            document.body.removeChild(tempInput);

            showToast(customMessage || 'Copiado al portapapeles');
        }

        // Mostrar notificación tipo Toast
        function showToast(message) {
            const toast = document.getElementById('toast');
            const toastMessage = document.getElementById('toast-message');
            toastMessage.textContent = message;
            
            toast.classList.remove('hidden');
            setTimeout(() => {
                toast.classList.add('hidden');
            }, 3000);
        }

        // Lógica para cambiar entre pestañas de contenido
        function switchTab(tab) {
            document.querySelectorAll('.tab-btn').forEach(btn => btn.classList.remove('active'));
            const activeTabBtn = document.getElementById('tab-' + tab);
            if (activeTabBtn) activeTabBtn.classList.add('active');

            const sections = {
                'exp': document.getElementById('section-exp'),
                'skills': document.getElementById('section-skills'),
                'edu': document.getElementById('section-edu')
            };

            if (tab === 'all') {
                Object.values(sections).forEach(s => s && s.classList.remove('hidden'));
            } else {
                Object.keys(sections).forEach(key => {
                    if (sections[key]) {
                        if (key === tab) {
                            sections[key].classList.remove('hidden');
                        } else {
                            sections[key].classList.add('hidden');
                        }
                    }
                });
            }
        }

        // Manejo del formulario de contacto
        function handleFormSubmit(event) {
            event.preventDefault();
            const nombre = document.getElementById('nombre').value;
            showToast(`¡Gracias ${nombre}! Tu mensaje ha sido procesado.`);
            document.getElementById('contactForm').reset();
        }
    </script>
</body>
</html>
